# Core functionality requires no secrets or paid APIs.
# Optional server-only Scenario Composer via CloseRouter. Never use NEXT_PUBLIC for this key.
CLOSEROUTER_API_KEY=
SCENARIO_MODEL=openai/gpt-5.5

# Real accounts: provision Neon Auth + Postgres, run scripts/init-accounts.mjs first.
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
